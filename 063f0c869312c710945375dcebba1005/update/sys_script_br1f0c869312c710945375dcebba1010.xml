        <query_condition/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Derive short_description from the first 160 chars of the user request
    var req = current.getValue('request') || '';
    if (!current.getValue('short_description') && req) {
        current.setValue('short_description', req.substring(0, 160));
    }

    // Ensure state defaults to 'pending' when not already set
    if (!current.getValue('state')) {
        current.setValue('state', 'pending');
    }
})(current, previous);]]></script>
